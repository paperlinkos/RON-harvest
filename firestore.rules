rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superAdmin';
    }

    // Helper function for Soul Winning Record schema validation
    function isValidSoulRecord(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'location', 'createdAt', 'clientCreatedAt', 'syncStatus']) &&
             data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() >= 7 &&
             data.location is string && data.location.size() > 0 &&
             data.syncStatus == 'synced';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow self-creation on signup
      allow create: if isOwner(userId) && request.resource.data.role == 'soulWinner' && request.resource.data.status == 'pendingAssignment';
      // Only superAdmin or authorized managers can alter status, role or assignment
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isSuperAdmin();
    }

    // Soul Winners Hierarchy Profiles Collection
    match /soulWinners/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Hierarchy assignments (pcfId, churchId, groupId, zoneId, status) can only be altered by superAdmin or authorized managers
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pcfId', 'churchId', 'groupId', 'zoneId', 'status']));
      allow delete: if isSuperAdmin();
    }

    // Organizational Collections (Zones, Groups, Churches, PCFs)
    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /churches/{churchId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /pcfs/{pcfId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Targets Collection (Zone, Group, Church, PCF targets)
    match /targets/{targetId} {
      allow read: if true; // Public observers can read target numbers for aggregate progress calculation
      allow write: if isSuperAdmin(); // Only SuperAdmin can set or modify targets
    }

    // Events Collection (Public read, SuperAdmin write)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Event Audit Logs Collection (SuperAdmin only)
    match /eventAuditLogs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Import History Collection (SuperAdmin only)
    match /importHistory/{importId} {
      allow read, write: if isSuperAdmin();
    }

    // Admin Audit Logs Collection (SuperAdmin only)
    match /adminAuditLogs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Soul Winning Records Collection
    match /soulWinningRecords/{recordId} {
      // Must be authenticated, and soulWinnerId must match authenticated identity
      allow create: if isAuthenticated() &&
                      request.resource.data.id == recordId &&
                      request.resource.data.soulWinnerId == request.auth.uid &&
                      isValidSoulRecord(request.resource.data);

      allow read: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Default rule
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
